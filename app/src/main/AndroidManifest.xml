<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required for BootReceiver to fire. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- WorkManager needs this on some ROMs for expedited work, harmless otherwise. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Shizuku Permission -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!--
        QUERY_ALL_PACKAGES
        Required on some OEM ROMs (OPPO, older Xiaomi) that do not honor
        the intent-based <queries> block for getInstalledApplications().
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <provider android:authorities="com.shizuposed.manager.status" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ShizuPosedManagerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShizuPosedManager"
        android:resizeableActivity="true"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="37">

        <!-- Shizuku Provider -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
            ModuleStatusProvider

            Exported and world-readable so module UIs in their own
            processes can query their own activation state. Read-only:
            insert/update/delete throw UnsupportedOperationException in
            ModuleStatusProvider. grantUriPermissions is left enabled so
            the manager can hand out read grants via Intent if it ever
            needs to (it does not currently).
        -->
        <provider
            android:name=".status.ModuleStatusProvider"
            android:authorities="com.shizuposed.manager.status"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:grantUriPermissions="true" />

        <!--
            ShizukuBinderWatcher

            A no-op ContentProvider whose only purpose is to give the
            app a component Android creates eagerly and keeps alive for
            the process lifetime. Inside its onCreate() it registers
            Shizuku.addBinderReceivedListenerSticky and
            addBinderDeadListener, so the app is notified whenever
            Shizuku's server comes up or goes down — regardless of the
            reason. When the binder is received, it starts
            ShizuPosedService.

            The case this exists for: Shizuku-Next's "ADB without
            Developer options" switch takes Shizuku's server down while
            a target app is in the foreground and brings it back when
            the app exits. Without the watcher, nothing tells ShizuPosed
            that the server has returned, and the service stays stopped
            until the user opens the app.

            The provider is not exported and has no public URI surface.
            Android only needs it to exist so it will be instantiated.
            No <intent-filter> and no <meta-data> are needed.
        -->
        <provider
            android:name=".watcher.ShizukuBinderWatcher"
            android:authorities="${applicationId}.shizuku-watcher"
            android:enabled="true"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ShizuPosedManager"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            ShizuPosedService

            foregroundServiceType is specialUse. Android 15 forbids
            starting a dataSync FGS from BOOT_COMPLETED; specialUse is
            permitted at boot subject to the general background-start
            rules, and it is the correct semantic type for this service.

            The <property> tag is REQUIRED for specialUse on Android 14+.
        -->
        <service
            android:name=".service.ShizuPosedService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Privileged Shizuku-backed hooking and module deployment service" />
        </service>

        <!--
            Boot Receiver.

            Kept android:enabled="false" — the receiver only does work if
            you explicitly enable it at runtime (via PackageManager) and
            the user has opted in to auto-start.

            It no longer calls startForegroundService() directly. Instead
            it enqueues a WorkManager job that retries until the platform
            allows the FGS start (which on Android 15 is often only after
            the app has been foregrounded at least once).
        -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>