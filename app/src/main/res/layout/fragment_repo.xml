<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="?android:attr/windowBackground">

    <ImageView
        android:id="@+id/ivRepoIcon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_repo"
        android:alpha="0.35"
        android:contentDescription="@string/nav_repo"
        app:tint="?android:attr/textColorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.35" />

    <TextView
        android:id="@+id/tvRepoTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/repo_not_implemented_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/ivRepoIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvRepoMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/repo_not_implemented_message"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvRepoTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="360dp" />

    <TextView
        android:id="@+id/tvRepoHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/repo_coming_soon"
        android:textSize="12sp"
        android:textStyle="italic"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvRepoMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>