<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_xstealth"
                android:contentDescription="XStealth icon"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="XStealth"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvXStealthStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inactive"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <!-- Master toggle -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchMaster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable XStealth"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hides ShizuPosed's presence from the checks most apps perform. Applies to every app launched under ShizuPosed. Does not defeat hardware attestation or apps running with root."
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="16dp" />

        <!-- Next toggle -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable XStealth Next"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aggressive native engine. Patches libc syscall stubs to raise the bar against native detection kits. More effective than the standard hiding, and slightly more likely to affect apps that do unusual native work. Off by default."
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="16dp" />

        <!-- Per-check toggles -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchHideDev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hide Developer Options"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchHideAdb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hide ADB enabled"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchHideShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hide Shizuku package"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchHideShizuPosed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hide ShizuPosed package"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchHideProcesses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hide running processes"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchHideProcFs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hide /proc entries"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scrubs ShizuPosed-related paths from /proc/self/maps, cmdline, status, and mountinfo. Requires the native engine."
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchApiProtection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Protect Xposed API calls"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Refuses Xposed class lookups from non-module code. Makes the shim classes harder to fingerprint at runtime. Off by default."
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDexOptimize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Optimize module dex"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Runs dex2oat on module dex files before pushing them to the shell side. Faster module loading on cold start. Falls back to the original dex if optimization fails. Off by default."
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>