<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardModule"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Status indicator dot -->
        <View
            android:id="@+id/indicatorStatus"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/status_indicator_disabled"
            android:layout_marginEnd="12dp" />

        <!-- App icon -->
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_module"
            android:contentDescription="@string/module_icon"
            android:layout_marginEnd="12dp" />

        <!-- Middle column: name, toggle, scope -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Module name -->
            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Module Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Package name -->
            <TextView
                android:id="@+id/tvPackage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="com.example.module"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:maxLines="1"
                android:ellipsize="middle" />

            <!-- Enable switch row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:minWidth="0dp" />

                <TextView
                    android:id="@+id/tvEnabledLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Enabled"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- Scope summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvScopeSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="No apps scoped"
                    android:textSize="12sp"
                    android:textColor="?attr/colorPrimary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvRecommended"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="· 0 recommended"
                    android:textSize="11sp"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Hidden legacy views: kept so older code doesn't NPE -->
            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tvEntry"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tvHookedApps"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Trailing chevron: "tap to edit scope" -->
        <ImageView
            android:id="@+id/ivChevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_right"
            android:alpha="0.5"
            android:contentDescription="Edit scope"
            android:layout_marginStart="8dp" />

        <!-- Hidden legacy button -->
        <Button
            android:id="@+id/btnSelectApps"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.cardview.widget.CardView>