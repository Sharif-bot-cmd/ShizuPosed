<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:minHeight="300dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Apps to Hook"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="12dp" />

    <!--
        ── CHANGE: added the Recommended chip.
        Same Assist style as the others so the group stays visually
        uniform. It selects every recommended app currently in the
        list. The chip is hidden by ModulesFragment when the module
        declares no scope.
    -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:singleLine="true"
        app:singleSelection="false"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="4dp"
        android:gravity="end">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipRecommended"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recommended"
            android:checkable="false"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSelectAll"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All"
            android:checkable="false"
            android:clickable="true"
            android:focusable="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipClearAll"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear"
            android:checkable="false"
            android:clickable="true"
            android:focusable="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSelectSystem"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System"
            android:checkable="false"
            android:clickable="true"
            android:focusable="true" />

    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
        android:hint="Search apps">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearchApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvSelectedCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 selected"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="4dp" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbHideSystem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hide system apps"
        android:checked="true"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="250dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apply Selection"
        style="@style/Widget.Material3.Button" />

</LinearLayout>