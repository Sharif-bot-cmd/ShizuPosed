<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivRepoDetailIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_module"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRepoDetailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Module"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvRepoDetailSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="v1.0 · by Author"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action buttons -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:singleSelection="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRepoOpenHomepage"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Homepage"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRepoOpenSupport"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Support"
            android:visibility="gone" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tlRepoDetailTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:tabMode="fixed">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="README" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Details" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <!-- README container -->
        <ScrollView
            android:id="@+id/svRepoReadmeContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/tvRepoReadmeContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.2"
                    android:textIsSelectable="true" />

                <TextView
                    android:id="@+id/tvRepoReadmeEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No README bundled in this module."
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:gravity="center"
                    android:padding="24dp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <!-- Details container -->
        <ScrollView
            android:id="@+id/svRepoDetailsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvRepoDetailsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.3"
                android:fontFamily="monospace"
                android:paddingBottom="24dp" />
        </ScrollView>

    </FrameLayout>

</LinearLayout>