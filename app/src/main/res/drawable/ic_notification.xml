<?xml version="1.0" encoding="utf-8"?>
<!--
    Notification small icon.

    Android renders small icons as a single-color silhouette: any
    color in this file is stripped and only the alpha channel is
    used as a mask. Fill color is #FFFFFF for historical reasons;
    the actual value is ignored.

    Composition matches the launcher icon: the Android head sits
    above the Material "extension" puzzle. At 24dp, only simple
    shapes read cleanly, so the antennae and the head's eyes are
    omitted — they turn to mush at this size. The head is a solid
    silhouette; the puzzle is drawn as a single closed path.

    The puzzle path is the Material Design "extension" icon
    (Apache-2.0, google/material-design-icons), scaled from its
    native 24x24 viewport to fit the lower two-thirds of this
    canvas and translated up to sit below the head.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- ═══════════════════════════════════════════════════════
         ANDROID HEAD (top)
         ═══════════════════════════════════════════════════════
         Rounded top, flat bottom. Antennae and eyes are omitted:
         at 24dp they read as noise.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 7,4
                          A 5,4 0 0,1 17,4
                          L 17,8
                          L 7,8 Z" />

    <!-- ═══════════════════════════════════════════════════════
         PUZZLE PIECE (bottom)
         ═══════════════════════════════════════════════════════
         Material "extension" scaled to fit 5..19 in x and
         10..22 in y. The group maps the 24x24 source glyph to
         that region: scale 0.58, translate (5, 10).

         Note: the source glyph's own 0..24 bounds fill the group,
         so the visible size is the full 14x12 area.
    -->
    <group
        android:scaleX="0.58"
        android:scaleY="0.5"
        android:translateX="5"
        android:translateY="10">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M20.5,11H19V7c0,-1.1 -0.9,-2 -2,-2h-4V3.5C13,2.12 11.88,1 10.5,1S8,2.12 8,3.5V5H4C2.9,5 2,5.9 2,7v3.8h1.5c1.49,0 2.7,1.21 2.7,2.7s-1.21,2.7 -2.7,2.7H2V20c0,1.1 0.9,2 2,2h3.8v-1.5c0,-1.49 1.21,-2.7 2.7,-2.7c1.49,0 2.7,1.21 2.7,2.7V22H18c1.1,0 2,-0.9 2,-2v-4h1.5c1.38,0 2.5,-1.12 2.5,-2.5S21.88,11 20.5,11z" />
    </group>
</vector>