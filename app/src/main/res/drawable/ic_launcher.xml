<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        ShizuPosed launcher icon.

        An X, drawn as two crossing strokes with a small center gap.
        Foreground layer for the adaptive icon. The background is a
        rounded-rect gradient that lives in a separate layer, so
        this drawable is safe to use both as a standalone icon and
        as the adaptive foreground.

        Colors:
          • White strokes on a gradient background
          • Green gradient matches the LSPosed visual family
    -->

    <!-- Descending stroke: top-left to bottom-right -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 22,22
                          L 36,22
                          L 86,86
                          L 72,86
                          Z" />

    <!-- Ascending stroke: bottom-left to top-right -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 86,22
                          L 72,22
                          L 22,86
                          L 36,86
                          Z" />

    <!--
        A small square "spark" at the intersection point. Mirrors
        the LSPosed accent without the animation frame. Purely
        decorative; the X reads correctly without it.
    -->
    <path
        android:fillColor="#FFEB3B"
        android:pathData="M 51,51
                          L 57,51
                          L 57,57
                          L 51,57
                          Z" />
</vector>