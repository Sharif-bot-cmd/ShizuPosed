<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorOnSurfaceVariant">

    <!--
        Puzzle piece. The standard LSPosed-style module icon.

        Sized to match the Material 24x24 tab icon grid: the
        visual bounds span roughly 4..20 on each axis, leaving
        4 units of padding. That is the same footprint as
        Material's own Home, Settings, and Search icons, so the
        piece reads at the same weight in a bottom navigation
        bar or a tab strip.

        The tint attribute lets the host view color it. Nothing
        else needs to change for light/dark theme switches.
    -->

    <path
        android:fillColor="#000000"
        android:pathData="M 4.5,6
                          L 9,6
                          C 9,4.5 10,4 10.5,4
                          C 11,4 12,4.5 12,6
                          L 16.5,6
                          L 16.5,9
                          C 18,9 18.5,10 18.5,10.5
                          C 18.5,11 18,12 16.5,12
                          L 16.5,15.5
                          L 12,15.5
                          C 12,17 11,17.5 10.5,17.5
                          C 10,17.5 9,17 9,15.5
                          L 4.5,15.5
                          Z" />
</vector>