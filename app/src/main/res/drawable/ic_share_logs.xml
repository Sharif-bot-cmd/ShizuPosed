<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorOnPrimaryContainer">

    <!--
        Share icon. Three connected nodes — the standard Material
        shape for "share this content." Drawn with the same visual
        weight as ic_add_module so the two FABs match.

        Shape:
          - Right node (output): 2.5-unit radius circle
          - Top-left node (input): 2-unit radius circle
          - Bottom-left node (input): 2-unit radius circle
          - Two connecting strokes between them
    -->

    <!-- Right node -->
    <path
        android:fillColor="#000000"
        android:pathData="M 18,8
                          A 3,3 0 1,1 17.99,8 Z" />

    <!-- Top-left node -->
    <path
        android:fillColor="#000000"
        android:pathData="M 6,10
                          A 2.5,2.5 0 1,1 5.99,10 Z" />

    <!-- Bottom-left node -->
    <path
        android:fillColor="#000000"
        android:pathData="M 6,16
                          A 2.5,2.5 0 1,1 5.99,16 Z" />

    <!-- Connecting stroke: top-left to right -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M 8,11
                          L 15.5,9.5" />

    <!-- Connecting stroke: bottom-left to right -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M 8,15
                          L 15.5,12.5" />
</vector>