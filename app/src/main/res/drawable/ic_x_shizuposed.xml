<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        ShizuPosed app icon. A stylized X, in the LSPosed tradition.

        Two crossing strokes, thick, rounded ends, drawn at 45 degrees.
        The shape reads as "X" at any size and scales cleanly to
        adaptive-icon foreground dimensions.
    -->

    <!-- Descending stroke (top-left to bottom-right) -->
    <path
        android:fillColor="#000000"
        android:pathData="M 26,20
                          L 40,20
                          L 82,88
                          L 68,88
                          Z" />

    <!-- Ascending stroke (bottom-left to top-right) -->
    <path
        android:fillColor="#000000"
        android:pathData="M 82,20
                          L 68,20
                          L 26,88
                          L 40,88
                          Z" />

</vector>